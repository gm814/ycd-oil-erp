generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus { ACTIVE SUSPENDED }
enum ServiceOrderStatus { DRAFT OPEN IN_PROGRESS COMPLETED CANCELLED }
enum InvoiceStatus { DRAFT ISSUED PAID VOID }
enum PaymentMethod { CASH CARD TRANSFER CREDIT }
enum StockMovementType { RECEIPT ISSUE ADJUSTMENT RETURN TRANSFER }
enum ApprovalStatus { PENDING APPROVED REJECTED CANCELLED }
enum CouponStatus { ACTIVE USED EXPIRED CANCELLED }

model Organization {
  id        String   @id @default(cuid())
  nameAr    String
  brandName String
  vatNumber String?
  crNumber  String?
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  nameAr         String
  city           String?
  departments    Department[]
  employees      Employee[]
  shifts         Shift[]
  serviceOrders  ServiceOrder[]
  stockMovements StockMovement[]
  createdAt      DateTime       @default(now())
}

model Department {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  nameAr   String
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  status    UserStatus @default(ACTIVE)
  roles     UserRole[]
  auditLogs AuditLog[] @relation("ActorAudit")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  nameAr      String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model Employee {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  code      String   @unique
  nameAr    String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Customer {
  id            String         @id @default(cuid())
  name          String
  phone         String?        @index
  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
  invoices      Invoice[]
  createdAt     DateTime       @default(now())
}

model Vehicle {
  id             String          @id @default(cuid())
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  plate          String          @index
  make           String?
  model          String?
  year           Int?
  currentOdometer Int?
  serviceOrders  ServiceOrder[]
  history        VehicleHistory[]
}

model Product {
  id             String             @id @default(cuid())
  sku            String             @unique
  nameAr         String
  unit           String
  salePrice      Decimal            @db.Decimal(12,2)
  costPrice      Decimal            @db.Decimal(12,2)
  active         Boolean            @default(true)
  serviceItems   ServiceOrderItem[]
  stockMovements StockMovement[]
}

model Shift {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  openedAt  DateTime @default(now())
  closedAt  DateTime?
  openedBy  String
  closedBy  String?
  notes     String?
}

model ServiceOrder {
  id          String             @id @default(cuid())
  orderNo     String             @unique
  branchId    String
  branch      Branch             @relation(fields: [branchId], references: [id])
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id])
  vehicleId   String
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id])
  odometer    Int?
  technicianId String?
  status      ServiceOrderStatus @default(DRAFT)
  items       ServiceOrderItem[]
  invoice     Invoice?
  histories   VehicleHistory[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ServiceOrderItem {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  descriptionAr  String
  quantity       Decimal      @db.Decimal(12,3)
  unitPrice      Decimal      @db.Decimal(12,2)
  discount       Decimal      @default(0) @db.Decimal(12,2)
}

model StockMovement {
  id          String            @id @default(cuid())
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12,3)
  reference   String?
  performedBy String
  createdAt   DateTime          @default(now())
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNo      String        @unique
  serviceOrderId String        @unique
  serviceOrder   ServiceOrder  @relation(fields: [serviceOrderId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  subtotal       Decimal       @db.Decimal(12,2)
  discount       Decimal       @default(0) @db.Decimal(12,2)
  vatRate        Decimal       @db.Decimal(5,4)
  vatAmount      Decimal       @db.Decimal(12,2)
  total          Decimal       @db.Decimal(12,2)
  status         InvoiceStatus @default(DRAFT)
  payments       Payment[]
  coupons        Coupon[]
  createdAt      DateTime      @default(now())
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12,2)
  reference String?
  paidAt    DateTime      @default(now())
}

model VehicleHistory {
  id             String       @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  odometer       Int?
  summaryAr      String
  nextServiceKm  Int?
  nextServiceAt  DateTime?
  createdAt      DateTime     @default(now())
}

model Coupon {
  id        String       @id @default(cuid())
  serial    String       @unique
  invoiceId String
  invoice   Invoice      @relation(fields: [invoiceId], references: [id])
  status    CouponStatus @default(ACTIVE)
  issuedAt  DateTime     @default(now())
  usedAt    DateTime?
  expiresAt DateTime?
}

model Approval {
  id          String         @id @default(cuid())
  entityType  String
  entityId    String
  step        String
  requestedBy String
  decidedBy   String?
  status      ApprovalStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?
  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAudit", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}

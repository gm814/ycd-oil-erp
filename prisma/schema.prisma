  branchId String @unique
  branch Branch @relation(fields: [branchId], references: [id])
  captureEnabled Boolean @default(false)
  subscriptionId String?
  medadBranch Int?
  fiscalYear String @default("")
  warehouseNo String?
  costCenterNo String?
  salesmanId String?

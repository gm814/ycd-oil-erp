generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ServiceOrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  RETURN
  TRANSFER
}

enum ProductCategory {
  OIL
  FILTER
  BATTERY
  PART
  WASH_SUPPLY
  SERVICE
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CouponStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierInvoiceStatus {
  DRAFT
  MATCHED
  MISMATCH
  APPROVED_FOR_PAYMENT
  PAID
  VOID
}

model Organization {
  id        String   @id @default(cuid())
  nameAr    String
  brandName String
  vatNumber String?
  crNumber  String?
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  nameAr           String
  city             String?
  departments      Department[]
  employees        Employee[]
  users            User[]
  shifts           Shift[]
  serviceOrders    ServiceOrder[]
  stockMovements   StockMovement[]
  redeemedCoupons  Coupon[]          @relation("CouponRedemptionBranch")
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]
  createdAt        DateTime          @default(now())
}

model Department {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  nameAr   String
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  roles        UserRole[]
  auditLogs    AuditLog[] @relation("ActorAudit")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  nameAr      String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model Employee {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  code      String   @unique
  nameAr    String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Customer {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  vehicles      Vehicle[]
  serviceOrders ServiceOrder[]
  invoices      Invoice[]
  createdAt     DateTime       @default(now())
  @@index([phone])
}

model Vehicle {
  id              String           @id @default(cuid())
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  plate           String
  make            String?
  model           String?
  year            Int?
  currentOdometer Int?
  serviceOrders   ServiceOrder[]
  history         VehicleHistory[]
  @@index([plate])
}

model Product {
  id                   String                @id @default(cuid())
  sku                  String                @unique
  nameAr               String
  category             ProductCategory       @default(OTHER)
  unit                 String
  salePrice            Decimal               @db.Decimal(12,2)
  costPrice            Decimal               @db.Decimal(12,2)
  minStock             Decimal               @default(0) @db.Decimal(12,3)
  grantsWashCoupon     Boolean               @default(false)
  active               Boolean               @default(true)
  serviceItems         ServiceOrderItem[]
  stockMovements       StockMovement[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Shift {
  id            String         @id @default(cuid())
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  openedAt      DateTime       @default(now())
  closedAt      DateTime?
  openedBy      String
  closedBy      String?
  openingCash   Decimal        @default(0) @db.Decimal(12,2)
  expectedCash  Decimal?       @db.Decimal(12,2)
  countedCash   Decimal?       @db.Decimal(12,2)
  cashVariance  Decimal?       @db.Decimal(12,2)
  notes         String?
  serviceOrders ServiceOrder[]
  @@index([branchId, closedAt])
}

model ServiceOrder {
  id           String             @id @default(cuid())
  orderNo      String             @unique
  branchId     String
  branch       Branch             @relation(fields: [branchId], references: [id])
  shiftId      String?
  shift        Shift?             @relation(fields: [shiftId], references: [id])
  customerId   String
  customer     Customer           @relation(fields: [customerId], references: [id])
  vehicleId    String
  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id])
  odometer     Int?
  technicianId String?
  status       ServiceOrderStatus @default(DRAFT)
  items        ServiceOrderItem[]
  invoice      Invoice?
  histories    VehicleHistory[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  @@index([branchId, shiftId])
}

model ServiceOrderItem {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  descriptionAr  String
  quantity       Decimal      @db.Decimal(12,3)
  unitPrice      Decimal      @db.Decimal(12,2)
  discount       Decimal      @default(0) @db.Decimal(12,2)
}

model StockMovement {
  id          String            @id @default(cuid())
  branchId    String
  branch      Branch            @relation(fields: [branchId], references: [id])
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12,3)
  reference   String?
  performedBy String
  createdAt   DateTime          @default(now())
  @@index([branchId, productId, createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNo      String        @unique
  serviceOrderId String        @unique
  serviceOrder   ServiceOrder  @relation(fields: [serviceOrderId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  subtotal       Decimal       @db.Decimal(12,2)
  discount       Decimal       @default(0) @db.Decimal(12,2)
  vatRate        Decimal       @db.Decimal(5,4)
  vatAmount      Decimal       @db.Decimal(12,2)
  total          Decimal       @db.Decimal(12,2)
  status         InvoiceStatus @default(DRAFT)
  payments       Payment[]
  coupons        Coupon[]
  createdAt      DateTime      @default(now())
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12,2)
  reference      String?
  idempotencyKey String?       @unique
  paidAt         DateTime      @default(now())
  @@index([method, paidAt])
}

model VehicleHistory {
  id             String       @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  odometer       Int?
  summaryAr      String
  nextServiceKm  Int?
  nextServiceAt  DateTime?
  createdAt      DateTime     @default(now())
}

model Coupon {
  id               String       @id @default(cuid())
  serial           String       @unique
  invoiceId        String
  invoice          Invoice      @relation(fields: [invoiceId], references: [id])
  status           CouponStatus @default(ACTIVE)
  issuedAt         DateTime     @default(now())
  usedAt           DateTime?
  expiresAt        DateTime?
  redeemedBranchId String?
  redeemedBranch   Branch?      @relation("CouponRedemptionBranch", fields: [redeemedBranchId], references: [id])
  redeemedBy       String?
  @@index([status, expiresAt])
}

model Supplier {
  id        String            @id @default(cuid())
  code      String            @unique
  nameAr    String
  vatNumber String?
  crNumber  String?
  phone     String?
  email     String?
  active    Boolean           @default(true)
  quotes    SupplierQuote[]
  orders    PurchaseOrder[]
  invoices  SupplierInvoice[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model PurchaseRequest {
  id          String                @id @default(cuid())
  requestNo   String                @unique
  branchId    String
  branch      Branch                @relation(fields: [branchId], references: [id])
  requestedBy String
  reason      String?
  status      PurchaseRequestStatus @default(PENDING_APPROVAL)
  items       PurchaseRequestItem[]
  quotes      SupplierQuote[]
  order       PurchaseOrder?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  @@index([branchId, status, createdAt])
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Decimal         @db.Decimal(12,3)
  notes             String?
}

model SupplierQuote {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id])
  quoteNo           String?
  totalAmount       Decimal         @db.Decimal(12,2)
  validUntil        DateTime?
  selected          Boolean         @default(false)
  notes             String?
  createdAt         DateTime        @default(now())
  purchaseOrder     PurchaseOrder?
  @@index([purchaseRequestId, supplierId])
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  orderNo           String              @unique
  branchId          String
  branch            Branch              @relation(fields: [branchId], references: [id])
  purchaseRequestId String              @unique
  purchaseRequest   PurchaseRequest     @relation(fields: [purchaseRequestId], references: [id])
  supplierId        String
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  supplierQuoteId   String?             @unique
  supplierQuote     SupplierQuote?      @relation(fields: [supplierQuoteId], references: [id])
  status            PurchaseOrderStatus @default(APPROVED)
  subtotal          Decimal             @db.Decimal(12,2)
  vatRate           Decimal             @db.Decimal(5,4)
  vatAmount         Decimal             @db.Decimal(12,2)
  total             Decimal             @db.Decimal(12,2)
  createdBy         String
  items             PurchaseOrderItem[]
  receipts          GoodsReceipt[]
  supplierInvoices  SupplierInvoice[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([branchId, status, createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(12,3)
  unitCost        Decimal       @db.Decimal(12,2)
  receiptItems    GoodsReceiptItem[]
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  receiptNo       String             @unique
  branchId        String
  branch          Branch             @relation(fields: [branchId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy      String
  supplierDeliveryRef String?
  items           GoodsReceiptItem[]
  createdAt       DateTime           @default(now())
  @@index([purchaseOrderId, createdAt])
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  quantity            Decimal           @db.Decimal(12,3)
}

model SupplierInvoice {
  id                   String                @id @default(cuid())
  invoiceNo            String
  supplierId           String
  supplier             Supplier              @relation(fields: [supplierId], references: [id])
  branchId             String
  branch               Branch                @relation(fields: [branchId], references: [id])
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  subtotal             Decimal               @db.Decimal(12,2)
  vatAmount            Decimal               @db.Decimal(12,2)
  total                Decimal               @db.Decimal(12,2)
  status               SupplierInvoiceStatus @default(DRAFT)
  threeWayMatched      Boolean               @default(false)
  matchedAt            DateTime?
  approvedForPaymentAt DateTime?
  approvedForPaymentBy String?
  paidAt               DateTime?
  paymentReference     String?
  createdBy            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  @@unique([supplierId, invoiceNo])
  @@index([branchId, status, createdAt])
}

model Approval {
  id          String         @id @default(cuid())
  entityType  String
  entityId    String
  step        String
  requestedBy String
  decidedBy   String?
  status      ApprovalStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?
  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAudit", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
}

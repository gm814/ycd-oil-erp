DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ycd_oil_erp?schema=public"
NEXT_PUBLIC_APP_NAME="YCD OIL ERP"
VAT_RATE="0.15"
WASH_COUPON_VALIDITY_DAYS="30"
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="set-a-strong-password-locally"

# Keep false in production until management authorizes commercial launch.
# Set true only in a controlled UAT/test environment.
ALLOW_PREOPENING_OPERATIONS="false"

# Pilot only: offline service orders. Keep false until the rollout gates pass.
YCD_OFFLINE_PILOT=false

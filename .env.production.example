# YCD OIL ERP - production environment template
# Do not commit real secrets. Copy these keys into the production secret manager.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ycd_oil_erp?schema=public&sslmode=require"
NEXT_PUBLIC_APP_NAME="YCD OIL ERP"
VAT_RATE="0.15"
WASH_COUPON_VALIDITY_DAYS="30"

# Generate at least 48 random characters and keep it only in the production secret manager.
AUTH_SECRET="REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS"

# Optional bootstrap admin. Remove/disable after named employee accounts are provisioned.
ADMIN_USERNAME="admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Must remain false in production. UAT bypass is not allowed on the live environment.
ALLOW_PREOPENING_OPERATIONS="false"
